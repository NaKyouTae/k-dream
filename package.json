{
  "name": "k-dream",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:server": "turbo run dev --filter=server",
    "dev:portal": "turbo run dev --filter=portal",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "deploy": "turbo run build --filter=portal && firebase deploy --only hosting"
  },
  "devDependencies": {
    "turbo": "^2.6.1",
    "typescript": "^5"
  }
}
