PORT=17000

# ── DB ─────────────────────────────────────────────────────────
# Supabase 는 Session pooler(5432) 를 쓴다. Direct 는 IPv6 전용이고,
# Transaction pooler(6543) 는 prisma migrate 가 동작하지 않는다.
# ?pgbouncer=true 는 트랜잭션 풀러 전용이므로 붙이지 않는다.
DATABASE_URL="postgresql://postgres.<project-ref>:<비밀번호>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# prisma migrate dev 전용. 배포 환경에는 필요 없다.
SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:5432/k-dream-shadow?schema=public"

# ── 인증 ───────────────────────────────────────────────────────
JWT_SECRET=k-dream-dev-secret-change-in-production

# 관리자가 하나도 없을 때만 만들어지는 최초 계정
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD="admin123!@#"
ADMIN_NAME=K-DREAM 관리자

# 관리자 콘솔·포털 주소 (쉼표 구분). 비우면 localhost 기본값을 쓴다.
# CORS_ORIGINS=https://k-dream-admin.vercel.app,https://k-dream.vercel.app

# ── 서류 저장소 (Supabase Storage) ──────────────────────────────
# 세 값이 모두 있어야 Supabase 를 쓴다. 하나라도 없으면 로컬 디스크에 저장하며,
# NODE_ENV=production 에서는 아예 기동을 막는다.
# 키는 Settings → API → Secret keys 의 sb_secret_... 값이다.
# (sb_publishable_... 은 브라우저용이라 비공개 버킷에 쓸 수 없다)
SUPABASE_URL=https://pxugtseppdhwmxrkdghi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_W9QesQbe3BHBrdLfO-sTNA_zmuBLnDM
SUPABASE_STORAGE_BUCKET=students
